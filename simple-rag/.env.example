GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET_KEY=your-long-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
MCP_AUTHORIZATION_ENDPOINT=https://custom-mcp-by-ganesh.fastmcp.app/oauth2/authorize

# Gmail OAuth (separate from the Horizon/MCP OAuth above -- see
# gmail_oauth.py's module docstring for why). Create these in Google
# Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application), with the Gmail API enabled and
# http://localhost:8000/gmail/callback registered as an authorized
# redirect URI (swap in your real BACKEND_BASE_URL in production).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional -- separate secret for signing the OAuth `state` param.
# Falls back to GOOGLE_CLIENT_SECRET if unset.
GMAIL_STATE_SECRET=

# Calendar/Meet OAuth reuses the SAME GOOGLE_CLIENT_ID/SECRET above --
# see calendar_oauth.py's module docstring. Just also enable the
# Google Calendar API for this client and add
# http://localhost:8000/calendar/callback as an authorized redirect
# URI (swap in your real BACKEND_BASE_URL in production). No new env
# vars needed.

# ---------------------------------------------------------------------
# LLM provider routing (see llm.py). ALL OPTIONAL: with none of these
# set, every LLM call goes straight to Groq exactly as before.
# ---------------------------------------------------------------------
# Global default provider: groq | groq_bedrock | bedrock | litellm
#   groq_bedrock = Groq primary, AWS Bedrock automatic failover (in-process)
LLM_PROVIDER=groq
# Per-role overrides (roles: AGENT, INTENT, CHAT, RAG, GUARDRAILS).
# Roll out one role at a time, starting with INTENT; AGENT last.
# LLM_INTENT_PROVIDER=litellm
# LLM_AGENT_PROVIDER=litellm
# LLM_CHAT_PROVIDER=litellm
# LLM_RAG_PROVIDER=
# LLM_GUARDRAILS_PROVIDER=
# Optional model override. For litellm this is the proxy alias
# (default "<role>-llm", e.g. agent-llm); for bedrock it is REQUIRED
# and must be a Bedrock model / inference-profile id.
# LLM_AGENT_MODEL=

# LiteLLM proxy (see litellm/docker-compose.yml)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-change-me            # must equal LITELLM_MASTER_KEY (or a virtual key)
LITELLM_MASTER_KEY=sk-change-me
LITELLM_TIMEOUT=60

# AWS Bedrock (direct provider, or used by the LiteLLM proxy fallback).
# In production prefer an IAM role over static keys.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Bedrock model / inference-profile id (required for groq_bedrock and bedrock).
# Per-role override: LLM_<ROLE>_BEDROCK_MODEL
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Groq retries before failing over to Bedrock (default 1)
# LLM_FAILOVER_GROQ_RETRIES=1