GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET_KEY=your-long-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
MCP_AUTHORIZATION_ENDPOINT=https://custom-mcp-by-ganesh.fastmcp.app/oauth2/authorize

# Gmail OAuth (separate from the Horizon/MCP OAuth above -- see
# gmail_oauth.py's module docstring for why). Create these in Google
# Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application), with the Gmail API enabled and
# http://localhost:8000/gmail/callback registered as an authorized
# redirect URI (swap in your real BACKEND_BASE_URL in production).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional -- separate secret for signing the OAuth `state` param.
# Falls back to GOOGLE_CLIENT_SECRET if unset.
GMAIL_STATE_SECRET=